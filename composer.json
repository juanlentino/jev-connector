{
	"name": "juanlentino/jev-connector",
	"description": "WordPress connector for the TypeSafe System One API (Jev).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/juanlentino/jev-connector",
	"support": {
		"issues": "https://github.com/juanlentino/jev-connector/issues",
		"security": "https://github.com/juanlentino/jev-connector/security/advisories/new"
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"check": [
			"@lint",
			"@test"
		]
	}
}
